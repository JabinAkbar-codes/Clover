# Copy to .env for local development.
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origin(s) allowed to call the API (comma separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (pick ONE) ---
# 1) Default: SQLite (nothing to set)
# 2) Postgres / any URL (used on Render):  DATABASE_URL=postgres://user:pass@host:5432/dbname
# 3) MySQL (local):
USE_MYSQL=False
DB_NAME=clover_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
